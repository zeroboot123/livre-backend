# ==============================================================
# LIVRE BACKEND — Variáveis de Ambiente
# ==============================================================
# Copie para .env e preencha:
#   cp .env.example .env
#
# No EasyPanel, configure em "Ambiente" (as mesmas variáveis).
# NUNCA faça commit do .env real.
#
# Legenda:
#   [obrigatória]  o serviço não inicia sem ela
#   [opcional]     possui valor padrão indicado
# ==============================================================

# ── Versão / imagens (EasyPanel + GHCR) ──────────────────────
# Tag exata publicada no GHCR. Use sempre uma versão, nunca "latest".
# [obrigatória no compose do EasyPanel]
APP_VERSION=0.9.2

# ── Domínio público ──────────────────────────────────────────
# URL pública sem barra no final. [obrigatória]
PUBLIC_URL=https://meuapp.com.br

# Domínio sem protocolo (usado apenas pelos composes locais/VPS).
# [opcional]
DOMAIN=meuapp.com.br

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
# Usuário administrador do banco. Mantido como "livre_admin" para
# compatibilidade com os roles já existentes. [opcional]
DB_SUPERUSER=livre_admin
# Senha do usuário administrador. [obrigatória]
DB_SUPERPASS=coloque_uma_senha_forte_aqui

# Usuários dedicados (usados SOMENTE pelo docker-compose.yml e
# docker-compose.vps.yml; o compose do EasyPanel usa DB_SUPERUSER).
# Só defina se esses roles existirem no banco.
# PG_AUTHUSER=livre_auth
# PG_AUTHPASS=coloque_uma_senha_forte_aqui
# PG_ADMINUSER=livre_admin_api
# PG_ADMINPASS=coloque_uma_senha_forte_aqui

# Limite de memória do Postgres (ex.: 512M). [opcional]
# PG_MEMORY_LIMIT=512M

# ── JWT ──────────────────────────────────────────────────────
# Chave longa e aleatória (mínimo 32 caracteres). [obrigatória]
# Gere com: openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_aleatoria_muito_longa_aqui
# Expiração do access token. [opcional: 15m]
# JWT_EXPIRATION=15m
# Expiração do refresh token. [opcional: 7d]
# JWT_REFRESH_EXPIRATION=7d

# ── Argon2 (hash de senhas) ──────────────────────────────────
# [opcional: 2]
# ARGON2_TIME_COST=2
# [opcional: 19456]
# ARGON2_MEMORY_COST=19456

# ── CORS ────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula ou "*"). [opcional: *]
# CORS_ORIGINS=*

# ── MinIO (armazenamento de arquivos) ────────────────────────
# [obrigatórias]
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=coloque_outra_senha_forte_aqui
# Nome do bucket. [opcional: livre-files]
# MINIO_BUCKET=livre-files

# ── Uploads / API ───────────────────────────────────────────
# Tamanho máximo de upload em MB. [opcional: 25]
# MAX_UPLOAD_MB=25
# Limite máximo de linhas por página na API de dados. [opcional: 1000]
# API_MAX_LIMIT=1000

# ── Criptografia de dados sensíveis ─────────────────────────
# Chave (fora do banco) para cifrar a senha SMTP em repouso
# (AES-256-GCM). Recomendada em produção. [opcional]
# EMAIL_ENCRYPTION_KEY=

# ── Worker (fila de tarefas) ────────────────────────────────
# Ainda não incluído no deploy do EasyPanel (preparado para o futuro).
# [opcionais]
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_TASK_TIMEOUT_MS=30000
# WORKER_AUTO_START=1

# ── Como gerar valores seguros ───────────────────────────────
# Linux/Mac:  openssl rand -hex 32
# Windows:    [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
