# ==============================================================
# LIVRE BACKEND - Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
#
# No EasyPanel, essas variáveis são configuradas na interface
# em "Environment" ao criar o projeto.
# ==============================================================

# ── Domínio público ──────────────────────────────────────────
# URL pública onde o Livre Backend será acessado.
# Ex: https://meuapp.com.br  (sem barra no final)
PUBLIC_URL=https://meuapp.com.br

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
# Senha do usuário livre_admin (obrigatório)
DB_SUPERPASS=coloque_uma_senha_forte_aqui

# ── JWT (JSON Web Token) ─────────────────────────────────────
# Chave secreta para assinar os tokens de autenticação.
# Use uma string longa e aleatória (mínimo 32 caracteres).
# Ex: openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_aleatoria_muito_longa_aqui

# ── MinIO (Armazenamento de Arquivos) ────────────────────────
# Usuário e senha do MinIO para upload de arquivos.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=coloque_outra_senha_forte_aqui

# Nome do bucket (opcional, padrão: livre-files)
# MINIO_BUCKET=livre-files

# ── Opcionais (já têm valores padrão seguros) ───────────────
# Limite máximo de upload (MB)
# MAX_UPLOAD_MB=25

# Tempo de expiração do access token
# JWT_EXPIRATION=15m

# Tempo de expiração do refresh token
# JWT_REFRESH_EXPIRATION=7d

# ── Como gerar senhas seguras ────────────────────────────────
# Linux/Mac:  openssl rand -hex 32
# Windows:    Abra PowerShell e execute:
#             [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))