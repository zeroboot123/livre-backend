# ==============================================================
# LIVRE BACKEND - Variáveis de Ambiente
# Copie este arquivo como .env e preencha os valores
# ==============================================================

# ─── Domínio ──────────────────────────────────────────────
DOMAIN=api.livrebackend.com.br
PUBLIC_URL=https://${DOMAIN}

# ─── PostgreSQL - Superusuário ─────────────────────────────
DB_SUPERUSER=livre_admin
DB_SUPERPASS=gerar_senha_forte_aqui_32_caracteres

# ─── PostgreSQL - Usuários de Serviço ──────────────────────
PG_AUTHUSER=livre_auth
PG_AUTHPASS=senha_auth_32_caracteres
PG_ADMINUSER=livre_admin_api
PG_ADMINPASS=senha_admin_32_caracteres

# ─── JWT ───��───────────────────────────────────────────────
JWT_SECRET=gerar_chave_256_bits_hex_aqui
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Argon2id (custo computacional) ────────────────────────
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=*

# ─── MinIO (Storage de arquivos) ───────────────────────────
MINIO_ROOT_USER=livre_minio
MINIO_ROOT_PASSWORD=gerar_senha_forte_minio_32_caracteres
MINIO_BUCKET=livre-files
MAX_UPLOAD_MB=25

# ─── Limites de Memória Docker ─────────────────────────────
PG_MEMORY_LIMIT=512M
